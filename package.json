{
	"name": "layan-theme",
	"displayName": "Layan Theme",
	"description": "A color theme inspired by Layan GTK Theme for VS Code, Cursor, Windsurf, VSCodium and other VS Code-based editors",
	"version": "1.2.0",
	"publisher": "xonTAB",
	"author": {
		"name": "Shaun Tabone",
		"url": "http://xontab.com"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/xontab/layan-vscode-theme.git"
	},
	"bugs": {
		"url": "https://github.com/xontab/layan-vscode-theme/issues"
	},
	"homepage": "https://github.com/xontab/layan-vscode-theme#readme",
	"engines": {
		"vscode": "^1.13.0",
		"sqlops": "*"
	},
	"categories": [
		"Themes"
	],
	"icon": "icon.png",
	"galleryBanner": {
		"color": "#25252a",
		"theme": "dark"
	},
	"contributes": {
		"themes": [
			{
				"label": "Layan (Dark)",
				"uiTheme": "vs-dark",
				"path": "./themes/layan-dark.json"
			}
		]
	},
	"keywords": [
		"layan",
		"dark",
		"gtk",
		"vinceliuice",
		"theme",
		"cursor",
		"windsurf",
		"vscodium",
		"open-vsx"
	],
	"scripts": {
		"package": "npx --yes @vscode/vsce@3 package",
		"publish:vsce": "npx --yes @vscode/vsce@3 publish",
		"publish:ovsx": "npx --yes ovsx@0.10 publish",
		"publish": "npm run publish:vsce && npm run publish:ovsx"
	},
	"dependencies": {}
}
